# Production assets origin (S3 REST endpoint or CloudFront)
ASSETS_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com
# Set to the QuoteApiBaseUrl output from the mp-mcp SAM deployment.
QUOTE_API_URL=http://localhost:3000
S3_BUCKET=your-bucket
S3_REGION=your-region
S3_KEY_PREFIX=assets/images
S3_AUDIO_KEY_PREFIX=assets/audio
AWS_PROFILE=your-aws-profile
